# Copy to .env (or set in your shell) — all secrets come from the
# environment; nothing is ever hardcoded.

# Provider: mock | openai | anthropic
GATEWAY_PROVIDER=mock

# Only needed for the matching provider:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Key used to HMAC-sign audit log entries. REQUIRED for real deployments;
# a well-known insecure dev key is used if unset.
# GATEWAY_AUDIT_HMAC_KEY=change-me-to-a-long-random-secret

# Where the audit log SQLite database lives.
# GATEWAY_AUDIT_DB=audit_log.db

# Optional JSON file overriding the default PII policy, e.g.
# {"PERSON": "tokenize", "CREDIT_CARD": "block", "DATE_TIME": "allow"}
# GATEWAY_POLICY_FILE=policy.json

# Minimum Presidio confidence score to act on a detection (0.0–1.0).
# GATEWAY_SCORE_THRESHOLD=0.4
