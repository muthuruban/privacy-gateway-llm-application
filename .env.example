# Copy to .env for local development. The .env file is loaded
# automatically from the working directory (documented behaviour).
# All values below are safe placeholders — never commit real secrets.

# Environment: development | test | production.
# production enforces strict secret validation (see README).
APP_ENV=development

# Provider: mock | openai | anthropic
GATEWAY_PROVIDER=mock

# Provider credentials (required for the matching provider in production):
# OPENAI_API_KEY=replace-with-your-openai-key
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key

# Audit record MAC key. REQUIRED in production: at least 32 characters,
# random, secret. In development/test an insecure built-in key is used
# if unset (audit MACs are then forgeable by design — dev only).
# GATEWAY_AUDIT_HMAC_KEY=replace-with-a-long-random-secret-32ch-min

# Administrative API key for GET /v1/audit/*. Endpoints stay disabled
# until this is set; send it in the X-Admin-Api-Key header.
# GATEWAY_ADMIN_API_KEY=replace-with-a-separate-admin-secret

# SQLite audit database path.
# GATEWAY_AUDIT_DB=audit_log.db

# External checkpoint file for tail-deletion/rollback detection. Must
# live outside the audit DB's trust domain in a real deployment.
# GATEWAY_AUDIT_CHECKPOINT=audit_checkpoint.json

# JSON policy override, e.g.
#   {"PERSON": "tokenize", "UK_NINO": "redact", "CREDIT_CARD": "block", "DATE_TIME": "allow"}
# GATEWAY_POLICY_FILE=policy.json

# Minimum detector confidence (0.0-1.0) to act on a detection.
# GATEWAY_SCORE_THRESHOLD=0.4

# Scan provider responses and irreversibly redact detected PII before
# returning them to the caller (false negatives still possible).
# GATEWAY_RESPONSE_SCAN=false

# Research/debug mode: store irreversibly redacted message content in
# audit records. OFF by default; redacted text can still contain
# undetected sensitive information.
# GATEWAY_AUDIT_STORE_REDACTED_CONTENT=false

# Outbound provider timeout in seconds.
# GATEWAY_PROVIDER_TIMEOUT=30
